#!/bin/bash
# Compares FUNC as built from its NONMATCHING C in src/NAME.c with the original asm the ROM uses,
# with the C lines of the new version above their instructions.
# Usage: bin/diff [NAME [FUNC [FROM [TO]]]]
# Without FUNC, lists the NONMATCHING functions (all, or only src/NAME.c's) and how far each is
# from matching.
# FROM and TO are regexes on instructions (e.g. ReachTileCost): only the part from the first
# FROM to the next TO is compared, on each side; calls show as "bl NAME". Branch
# targets aren't compared; they show as "→ N", the line they land on. In a terminal, shows the
# whole diff side by side in color (marks: ! the code differs, ~ only registers or stack offsets,
# - only in the original, + only in yours), with how many rows of each; piped, plain side-by-side. At the far right, code from a static inline is tagged ":222 → Edge#2": the 2nd
# copy of Edge, the one called at line 222. The counts also give the logic-only differences
# (registers, stack offsets and literal pool positions ignored) and whether the stack frames match.
# Options, anywhere on the line:
#   --logic        don't mark differences that are only registers or stack offsets
#   --nvim         open both listings in nvim -d instead
#   --qol          build the QOL version (default: the original game's)
# AGBCC=PATH builds yours with another agbcc (e.g. one patched to trace reload).
# Exits 0 when they match.
usage() { sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit ${1:-0}; }
args=() LOGIC= VIEW= QOL=0
while [ $# -gt 0 ]; do
	case $1 in
	--logic) LOGIC=1 ;;
	--nvim) VIEW=nvim ;;
	--qol) QOL=1 ;;
	-h | --help) usage ;;
	-*) echo "unknown option: $1" >&2; usage 2 ;;
	*) args+=("$1") ;;
	esac
	shift
done
set -- "${args[@]}"
if [ $# -lt 2 ]; then
	# One line per NONMATCHING function: the asm/non_matching/NAME/FUNC.inc that src/NAME.c
	# still includes as its NAKED fallback.
	opts=(); [ "$QOL" = 1 ] && opts+=(--qol)
	incs=$(grep -ohE 'asm/non_matching/[^/]+/[^/"]+\.inc' src/${1:-*}.c 2>/dev/null | sort -u)
	[ -n "$incs" ] || { echo "no NONMATCHING functions${1:+ in src/$1.c}" >&2; exit 2; }
	for inc in $incs; do
		name=${inc#asm/non_matching/} name=${name%%/*} func=$(basename $inc .inc)
		out=$("$0" "${opts[@]}" $name $func 2>&1 | tail -2 | tr '\n' ' ')
		printf '%-16s %-16s %s\n' $name $func "${out% }"
	done
	exit 0
fi
set -e
NAME=$1 FUNC=$2 FROM=$3 TO=$4
OUT=build/fdiff
mkdir -p $OUT
make -s QOL=$QOL build/totkol/src/$NAME.o
cc -E -I tools/agbcc -I tools/agbcc/include -iquote include -nostdinc -DREVISION=0 -DENGLISH \
	-DQOL=$QOL -DNONMATCHING src/$NAME.c -o $OUT/nm.i
tools/preproc/preproc $OUT/nm.i charmap.txt | ${AGBCC:-tools/agbcc/bin/agbcc} -mthumb-interwork -Wimplicit \
	-Wparentheses -O2 -g -fhex-asm -fprologue-bugfix -ffix-debug-line -o $OUT/nm.s
arm-none-eabi-as -mcpu=arm7tdmi -o $OUT/nm.o $OUT/nm.s

# Prints FUNC's instructions from object $1, one per line, without addresses. Branch targets are
# dropped (they move whenever the code above changes size); with ANNOT set, each branch shows its
# target as "→ N", N being that line in the same listing. With SRC set, also prints the C lines
# objdump -S shows (marked "C\t", instructions "A\t"), and with TAGS set writes to that file, one
# line per instruction, where it comes from in the C: "CALL|INLINE|LINE" ("222|Edge#2|157":
# line 157 of the 2nd copy of Edge, called at line 222), or "||LINE" outside inlines.
dump() {
	arm-none-eabi-objdump -d -r --no-show-raw-insn ${SRC:+-S -l} --disassemble=$FUNC $1 |
		sed -n '/^[0-9a-f]* <.*>:$/,$p' | tail -n +2 |
		awk -v inl="$INLINES" -v me="src/$NAME.c" '
			BEGIN {
				k = split(inl, r, " ")
				for (i = 1; i <= k; i++) { split(r[i], q, ":"); s[i] = q[1]; e[i] = q[2]; fn[i] = q[3] }
				# Where each inline is called: lines with "NAME(" outside its body.
				while ((getline x < me) > 0) {
					ln++
					for (i = 1; i <= k; i++)
						if ((ln < s[i] || ln > e[i]) && x ~ ("(^|[^A-Za-z0-9_])" fn[i] "\\("))
							call[i, ++nc[i]] = ln
				}
			}
			# With -l, "file:N" comes before each block of C lines, and the block ends at line N.
			function flush(   i) {
				if (pend != "") print pend
				pend = ""
				for (i = 1; i <= ns; i++)
					if (sl[i] ~ /[^ \t]/) print "C\t" (n ? n - ns + i : "") "\t" sl[i]
				ns = 0
			}
			/^\/.*:[0-9]+( \(discriminator [0-9]+\))?$/ {
				flush(); n = $0; sub(/ \(.*/, "", n); sub(/^.*:/, "", n)
				tag = ""
				if (!index($0, me ":")) next
				tag = "||" n
				for (i = 1; i <= k; i++)
					if (n + 0 >= s[i] && n + 0 <= e[i]) {
						# Each copy of an inline starts at its first line (the name, or the "{"
						# below it). It was called at the first call after the last line seen
						# outside it (or, failing that, at its Nth call).
						if (n + 0 <= s[i] + 1) {
							cnt[i]++; at[i] = call[i, cnt[i]]
							for (j = nc[i]; j >= 1; j--) if (call[i, j] >= out) at[i] = call[i, j]
						}
						tag = at[i] "|" fn[i] "#" cnt[i] "|" n
					}
				if (tag ~ /^\|\|/) out = n + 0
				next
			}
			/^[A-Za-z_][A-Za-z0-9_]*\(\):$/ { next }
			!/^\s+[0-9a-f]+:/ { sl[++ns] = $0; next }
			/^\s+[0-9a-f]+:/ {
				addr = $1; sub(/:$/, "", addr)
				t = $0; sub(/^\s+[0-9a-f]+:\s+/, "", t)
				gsub(/\s*<[^>]*>/, "", t); sub(/\s*@.*/, "", t); gsub(/\t+/, " ", t)
				# A relocation goes into its instruction or word: "bl NAME", ".word NAME". One on
				# its own is a word objdump left out because it is 0.
				if (t ~ /^R_ARM_/) {
					sym = t; sub(/^[^ ]+ /, "", sym)
					if (addr == paddr && pt == "bl") { pt = "bl " sym; ptarget = ""; set(); next }
					if (addr == paddr && pt ~ /^\.word /) {
						v = pt; sub(/^\.word /, "", v)
						pt = ".word " sym (v ~ /^0x0+$/ ? "" : "+" v); set(); next
					}
					t = ".word " sym
				}
				flush()
				target = ""
				if (t ~ /^b[a-z.]* [0-9a-f]+$/) {
					target = t; sub(/^.* /, "", target)  # a call loses it to its relocation
					sub(/ [0-9a-f]+$/, "", t)
				}
				paddr = addr; pt = t; ptarget = target; ptag = tag; set(); next
			}
			function set() { pend = "A\t" paddr "\t" pt "\t" ptarget "\t" ptag }
			END { flush() }' |
		awk -F '\t' -v from="$FROM" -v to="$TO" -v src="$SRC" -v annot="$ANNOT" -v tags="$TAGS" '
			/^C/ { if (src) c[++nc] = $0; next }
			!on && from != "" && $3 !~ from { nc = 0; next }
			{
				on = 1
				for (i = 1; i <= nc; i++) out[++n] = c[i]
				nc = 0
				out[++n] = $0; k++
				if (!($2 in line)) line[$2] = k
			}
			to != "" && $3 ~ to { exit }
			END {
				for (i = 1; i <= n; i++) {
					if (out[i] ~ /^C/) { print out[i]; continue }
					split(out[i], f, "\t")
					t = f[3]
					if (annot && f[4] != "") t = t " → " (f[4] in line ? line[f[4]] : "?")
					print src ? "A\t" t : t
					if (tags != "") print f[5] > tags
				}
			}'
}
# Side by side, highlighted like show, with the C lines of the new version above their
# instructions. Marks: ~ changed, - only in orig, + only in new.
show() {
	local sep=$'\x01'
	# Rows are lined up by the logic-only comparison, so each instruction sits next to its pair
	# even when registers differ. A row is "!" (or +/-) when the code differs, "~" when only
	# registers or stack offsets do (left unmarked with --logic).
	diff --old-line-format='<%L' --new-line-format='>%L' --unchanged-line-format='=%L' \
		$OUT/orig.logic $OUT/new.logic |
		awk -v OFS="$sep" -v ro=$OUT/orig.txt -v rn_=$OUT/new.txt -v only="$LOGIC" '
			BEGIN {
				while ((getline x < ro) > 0) O[++no] = x
				while ((getline x < rn_) > 0) N[++nn] = x
			}
			function row(t, l, r, hl, hr) {
				if (hl) ln++
				if (hr) rn++
				if (t == "~") t = "!"
				else if (t == " " && O[ln] != N[rn] && !only) t = "~"
				# A copy only one side has: logistics, not logic.
				if ((t == "-" && l ~ /^(copy|pool)$/) || (t == "+" && r ~ /^(copy|pool)$/))
					t = only ? " " : "~"
				print t, hl ? ln : "", hr ? rn : "", hl ? O[ln] : "", hr ? N[rn] : ""
			}
			function flush(   i, n) {
				n = nl > nr ? nl : nr
				for (i = 1; i <= n; i++)
					row(i > nl ? "+" : i > nr ? "-" : "~", L[i], R[i], i <= nl, i <= nr)
				nl = nr = 0; delete L; delete R
			}
			{ s = substr($0, 2) }
			/^</ { L[++nl] = s; next }
			/^>/ { R[++nr] = s; next }
			{ flush(); row(" ", s, s, 1, 1) }
			END { flush() }' |
		# Put each instruction's C lines (tag "c") in the rows above it.
		awk -F "$sep" -v OFS="$sep" '
			NR == FNR { if (/^C/) c[n + 1] = c[n + 1] substr($0, 3) "\n"; else n++; next }
			$3 != "" && $3 in c {
				k = split(c[$3], cl, "\n")
				for (i = 1; i < k; i++) {
					num = cl[i]; sub(/\t.*/, "", num); text = cl[i]; sub(/^[^\t]*\t/, "", text)
					print "c", num, "", "", text
				}
			}
			{ print }' $OUT/newsrc.txt - |
		# Show each side's text with its jump targets ("→ N"), which the comparison ignores.
		awk -F "$sep" -v OFS="$sep" '
			FILENAME == ARGV[1] { o[FNR] = $0; next }
			FILENAME == ARGV[2] { n[FNR] = $0; next }
			$1 != "c" { if ($2 != "") $4 = o[$2]; if ($3 != "") $5 = n[$3] }
			{ print }' $OUT/orig.ann $OUT/new.ann - > $OUT/rows.txt
	hl() {
		awk -F "$sep" -v f=$1 -v want="$2" '{ print ($1 ~ want) ? $f : "" }' $OUT/rows.txt |
			bat -l $3 --color=always --style=plain --paging=never
	}
	hl 4 . s > $OUT/left.txt
	hl 5 '[^c]' s > $OUT/right.txt
	hl 5 c c > $OUT/rightc.txt
	local w=$(cut -d "$sep" -f4 $OUT/rows.txt | awk '{ if (length > w) w = length } END { print w }')
	paste -d "$sep" $OUT/rows.txt $OUT/left.txt $OUT/right.txt $OUT/rightc.txt |
		awk -F "$sep" -v w=$w -v tagf=$OUT/new.tag '
		BEGIN {
			c["~"] = "\033[33m"; c["!"] = "\033[1;31m"; c["-"] = "\033[31m"; c["+"] = "\033[32m"
			c[" "] = c["c"] = "\033[90m"
			while ((getline x < tagf) > 0) tag[++nt] = x
		}
		$1 == "c" {
			printf "%*s\033[90m│ %4s \033[36m%5s\033[0m  %s\n", w + 8, "", "", $2 ? ":" $2 : "", $8
			next
		}
		{
			# Which inline copy the instruction on the right comes from, if any.
			# Inside an inline, which copy and where it was called: ":222 → Edge#2".
			t = ""
			if ($3 != "" && split(tag[$3], g, "|") && g[2] != "")
				t = sprintf("%*s\033[90m:%s → \033[35m%s\033[0m", 40 - length($5), "", g[1], g[2])
			printf "%s%s %4s\033[0m %s%*s %s│ %4s\033[0m %s%s\n", c[$1], $1, $2, $6, w - length($4), "",
				c[$1], $3, $7, t
		}'
}
dump build/totkol/src/$NAME.o > $OUT/orig.txt
ANNOT=1 dump build/totkol/src/$NAME.o > $OUT/orig.ann
ANNOT=1 dump $OUT/nm.o > $OUT/new.ann
# Inline functions in the C, as "first:last:name": from the line with the name to the closing "}".
INLINES=$(awk 'match($0, /^static inline [^(]*[ *]([A-Za-z_][A-Za-z0-9_]*)\(/) {
		f = $0; sub(/\(.*/, "", f); sub(/.*[ *]/, "", f); s = NR }
	s && /^}/ { printf "%d:%d:%s ", s, NR, f; s = 0 }' src/$NAME.c)
INLINES=$INLINES TAGS=$OUT/new.tag SRC=1 dump $OUT/nm.o > $OUT/newsrc.txt
sed -n "s/^A\t//p" $OUT/newsrc.txt > $OUT/new.txt
# Logic only: every register and stack offset made the same.
# Copies between registers are logistics too: "mov rX, rY" and "adds rX, rY, #0" are the same copy
# (agbcc picks one by whether high registers are involved), and so are "add rX, rY" and
# "adds rX, rX, rY". A copy one side has and the other doesn't isn't counted as logic either.
# Also not logic: addresses in a switch's jump table (".word .text+N"; they move with the code,
# like branch targets) and alignment padding (.short 0x0000).
# Nor where a constant sits: "ldr rX, [pc, #N]" becomes "ldr R, =VALUE" (the word at that
# address), and the literal pool itself "pool", like a copy. N changes whenever the code before
# it grows or shrinks. With FROM the addresses are unknown, so it's just "ldr R, [pc]".
logic() {
	awk -v part="$FROM" '
		# The address of each line: bl and .word take 4 bytes, the rest 2. A word is aligned to 4
		# (the padding before it is not always listed).
		function size(l) { return l ~ /^(bl|\.word)( |$)/ ? 4 : 2 }
		function align(x, l) { return l ~ /^\.word / ? int((x + 3) / 4) * 4 : x }
		NR == FNR { a = align(a, $0); if ($0 ~ /^\.word /) pool[a] = $2; a += size($0); next }
		{
			l = $0
			b = align(b, $0)
			if (match(l, /\[pc, #[0-9]+\]/)) {
				n = substr(l, RSTART + 6, RLENGTH - 7) + 0
				t = int((b + 4) / 4) * 4 + n
				l = substr(l, 1, RSTART - 1) (part != "" || !(t in pool) ? "[pc]" : "=" pool[t])
			}
			b += size($0)
			print l
		}' $1 $1 |
	sed -E 's/\b(r[0-9]+|sb|sl|fp|ip)\b/R/g; s/\[sp, #[0-9]+\]/[sp, #N]/g
		s/^(mov R, R|adds R, R, #0)$/copy/; s/^adds R, R, R$/add R, R/; s/^\.short 0x0000$/copy/
		s/=\.text(\+0x[0-9a-f]+)?$/=target/; s/^\.word \.text(\+.*)?$/jump/; s/^\.word .*/pool/; s/^jump$/.word target/'
}
logic $OUT/orig.txt > $OUT/orig.logic
logic $OUT/new.txt > $OUT/new.logic
if diff -q $OUT/orig.txt $OUT/new.txt > /dev/null; then
	echo "match ($(wc -l < $OUT/orig.txt) lines)"
else
	# Rows by mark, as shown: show also writes the rows.
	show > $OUT/view.txt
	count() { cut -d $'\x01' -f1 $OUT/rows.txt | grep -c "^$1$" || true; }
	summary="$(( $(count '!') + $(count -) + $(count +) )) rows with logic differences (! - +),"
	summary+=" $(count '~') only registers/stack (~)"
	# Stack frame: its size, and whether both use the same slots (they may hold other values).
	frame() { grep -m1 -o 'sub sp, #[0-9]*' $1 | grep -o '[0-9]*$' || echo 0; }
	slots() { grep -o '\[sp, #[0-9]*\]' $1 | sort -u; }
	fo=$(frame $OUT/orig.txt) fn=$(frame $OUT/new.txt)
	so=$(slots $OUT/orig.txt | wc -l) sn=$(slots $OUT/new.txt | wc -l)
	if [ -n "$FROM" ]; then
		# Only part of the function: the frame setup isn't in it, so compare just the slots.
		same=$(diff -q <(slots $OUT/orig.txt) <(slots $OUT/new.txt) > /dev/null && echo yes || true)
		frame_note="slots used in this part: $so in the original, $sn in yours${same:+, the same ones}"
	elif [ "$fo" = "$fn" ] && diff -q <(slots $OUT/orig.txt) <(slots $OUT/new.txt) > /dev/null; then
		frame_note="frame: same size ($fo bytes) and the same $so slots"
	else
		frame_note="frame: $fo bytes, $so slots in the original; $fn bytes, $sn slots in yours"
	fi
	summary+=" (orig $(wc -l < $OUT/orig.txt), new $(wc -l < $OUT/new.txt))"
	if [ ! -t 1 ]; then
		diff -y -W 100 $OUT/orig.txt $OUT/new.txt || true
	elif [ "$VIEW" = nvim ]; then
		nvim -d $OUT/orig.txt $OUT/new.txt
	else
		{
			printf '\033[1m%s\033[0m\n' "$summary"
			printf '\033[90m%s\033[0m\n' "$frame_note"
			printf '\033[90m%s\033[0m\n\n' \
				'! code differs   ~ only registers/stack   - only original   + only yours'
			cat $OUT/view.txt
		} | less -RS
	fi
	echo "$summary"
	echo "$frame_note"
	exit 1
fi

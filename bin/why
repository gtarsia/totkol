#!/bin/bash
# Explains why an instruction of FUNC's NONMATCHING build (as diff shows it) uses the registers
# it does: which of agbcc's values it works on, how often each is used and over how long, what
# register each got, the C line that creates each, and the values competing with it.
# Usage: bin/why NAME FUNC LINE   LINE: a line number of your side in diff
# Options: --orig  LINE is a line number of the original side
#          -v      also show agbcc's numbers for each value (uses, span, priority)
usage() { sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit ${1:-0}; }
args=() SIDE= VERBOSE=
while [ $# -gt 0 ]; do
	case $1 in
	--orig) SIDE=orig ;;
	-v) VERBOSE=1 ;;
	-h | --help) usage ;;
	-*) echo "unknown option: $1" >&2; usage 2 ;;
	*) args+=("$1") ;;
	esac
	shift
done
set -- "${args[@]}"
[ $# -lt 3 ] && usage
set -e
NAME=$1 FUNC=$2
W=build/why
mkdir -p $W
bin/diff $NAME $FUNC > /dev/null || true
# The same build as diff's, plus agbcc's notes: -da writes what each pass did, -dp puts each
# instruction's number in the asm.
tools/preproc/preproc build/fdiff/nm.i charmap.txt > $W/w.i
tools/agbcc/bin/agbcc -mthumb-interwork -Wimplicit -Wparentheses -O2 -g -fhex-asm \
	-fprologue-bugfix -ffix-debug-line -da -dp -o $W/w.s $W/w.i
arm-none-eabi-as -mcpu=arm7tdmi -aln=$W/list.txt -o $W/w.o $W/w.s
NAME=$NAME WHY_VERBOSE=$VERBOSE exec python3 bin/why.py $FUNC $3 $SIDE
